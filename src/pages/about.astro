---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ogImageUrl } from '../lib/og';
import portrait from '../assets/doohee.webp';
import { monthColor } from '../lib/monthColors';

const ogImage = await ogImageUrl(portrait, Astro.site);
// Same day-of-week accent the nav uses (see Header.astro).
const accent = monthColor(new Date().getDay());
---

<Base
  title="About — Doohee Lee"
  description="Doohee Lee — based in Georgia, pursuing photography as a part of everyday life."
  ogImage={ogImage}
>
  <section class="about free-center" style={`--accent-color: ${accent}`}>
    <figure class="portrait">
      <Image
        src={portrait}
        alt="Doohee Lee"
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 32rem, 80vw"
        quality={86}
        format="webp"
      />
    </figure>

    <h1 class="name">Doohee Lee</h1>
    <span class="rule" aria-hidden="true"></span>

    <div class="bio">
      <p>Based in Georgia. Pursuing photography as a part of everyday life.</p>
      <p>Drawn to stillness; longing for the natural.</p>
      <p>Music, film, and the sound of rain.</p>
      <p>Grateful that photography allows for thought.</p>
    </div>

    <ul class="links">
      <li><a href="mailto:dui0828@gmail.com">dui0828@gmail.com</a></li>
    </ul>
  </section>
</Base>

<style>
  .about {
    max-width: 32rem;
    margin: 0 auto;
    padding-top: clamp(0.5rem, 4vh, 3rem);
    text-align: center;
  }

  .portrait {
    margin: 0 0 2.25rem;
  }

  /* Same voice as the /works menu: Garamond name, short hairline, centered
     Garamond text; only the small contact line is sans. */
  .name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.005em;
    color: var(--text);
  }

  .rule {
    display: block;
    width: 2rem;
    height: 0;
    margin: 1.5rem auto;
    border-top: 0.5px solid var(--text-faint);
  }

  .bio {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
  }

  .bio p {
    margin: 0 0 0.5rem;
    line-height: 1.75;
    color: var(--text);
  }

  .links {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .links li + li {
    margin-top: 0.4rem;
  }

  .links a {
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--text);
    border-bottom-color: var(--accent-color, var(--text));
  }
</style>
