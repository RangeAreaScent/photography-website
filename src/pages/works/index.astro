---
// Works index — a quiet, centered table of contents (think a restaurant
// menu): one line per series, nothing else. The series themselves live at
// /works/[slug]; this page deliberately does not render any photos, so it
// can't drift out of sync with them.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { monthColor } from '../../lib/monthColors';

const series = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
// Same day-of-week accent the nav uses (see Header.astro).
const accent = monthColor(new Date().getDay());
---

<Base
  title="Works — Doohee Lee"
  description="Photo series by Doohee Lee."
>
  <section class="menu" style={`--accent-color: ${accent}`}>
    <h1 class="heading">Works</h1>
    <span class="rule" aria-hidden="true"></span>

    <ul class="items">
      {
        series.map((s) => (
          <li class="item">
            <a href={`/works/${s.id}`}>
              <span class="item-title">{s.data.title}</span>
              <span class="item-meta">
                {s.data.year}
                <span aria-hidden="true"> · </span>
                {s.data.photos.length} {s.data.photos.length === 1 ? 'photograph' : 'photographs'}
              </span>
              {s.data.intro && <span class="item-intro">{s.data.intro}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .menu {
    max-width: 32rem;
    margin: 0 auto;
    padding-top: clamp(2rem, 12vh, 7rem);
    text-align: center;
  }

  /* In sidebar mode the content column still reserves the (here empty)
     sub-nav width on the left; shift back so the menu is centered in the
     space that's actually free beside the sidebar. */
  @media (min-width: 1401px) {
    .menu {
      position: relative;
      left: calc(var(--subnav-w) / -2);
    }
  }

  .heading {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-muted);
    /* letter-spacing leaves a trailing gap; nudge back so it centers */
    padding-left: 0.28em;
  }

  .rule {
    display: block;
    width: 2rem;
    height: 0;
    margin: 1.25rem auto 3.5rem;
    border-top: 0.5px solid var(--text-faint);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .item a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .item-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: 0.005em;
    color: var(--text);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }

  .item a:hover .item-title,
  .item a:focus-visible .item-title {
    border-bottom-color: var(--accent-color, var(--text));
  }

  .item-meta {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .item-intro {
    max-width: 26rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Slow staggered fade-up on arrival, like courses being brought out. */
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .heading,
  .rule,
  .item {
    animation: arrive 900ms cubic-bezier(0, 0, 0.2, 1) both;
  }

  .rule {
    animation-delay: 120ms;
  }

  .item:nth-child(1) {
    animation-delay: 260ms;
  }

  .item:nth-child(2) {
    animation-delay: 400ms;
  }

  .item:nth-child(3) {
    animation-delay: 540ms;
  }

  .item:nth-child(n + 4) {
    animation-delay: 680ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .heading,
    .rule,
    .item {
      animation: none;
    }
  }
</style>
