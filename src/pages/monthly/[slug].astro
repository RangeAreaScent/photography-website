---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { ogImageUrl } from '../../lib/og';

export async function getStaticPaths() {
  // (getStaticPaths is hoisted, so it can't see helpers defined outside it.)
  const fmtMonth = (d: Date) => d.toLocaleString('en-US', { year: 'numeric', month: 'long' });
  // Newest first, so index+1 is the older month and index-1 the newer one.
  const entries = (await getCollection('monthly')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const link = (e?: CollectionEntry<'monthly'>) =>
    e ? { href: `/monthly/${e.id}`, label: fmtMonth(e.data.date) } : null;
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, older: link(entries[i + 1]), newer: link(entries[i - 1]) },
  }));
}

interface Props {
  entry: CollectionEntry<'monthly'>;
  older: { href: string; label: string } | null;
  newer: { href: string; label: string } | null;
}

const { entry, older, newer } = Astro.props;
const fmt = entry.data.date.toLocaleString('en-US', {
  year: 'numeric',
  month: 'long',
});
const ogImage = await ogImageUrl(entry.data.photo, Astro.site);
const description = `Monthly photograph — ${fmt}${entry.data.caption ? ` · ${entry.data.caption}` : ''}.`;

const { Content } = await render(entry);
const hasNote = (entry.body ?? '').trim().length > 0;
---

<Base
  title={`${fmt} — Doohee Lee`}
  description={description}
  ogImage={ogImage}
  ogType="article"
>
  <section class="single">
    <figure class="figure">
      <Picture
        src={entry.data.photo}
        alt={entry.data.caption ?? fmt}
        formats={['avif', 'webp']}
        widths={[800, 1280, 1920, 2560]}
        sizes="(min-width: 1024px) 70vw, 100vw"
        quality={82}
      />
      <figcaption>
        <div class="capbar">
          <span class="step step-older">
            {older && <a href={older.href} rel="prev" data-step="older">← {older.label}</a>}
          </span>
          <div class="cap">
            {entry.data.caption && <p class="title">{entry.data.caption}</p>}
            <p class="when">{fmt}</p>
          </div>
          <span class="step step-newer">
            {newer && <a href={newer.href} rel="next" data-step="newer">{newer.label} →</a>}
          </span>
        </div>
        {hasNote && (
          <div class="note">
            <Content />
          </div>
        )}
      </figcaption>
    </figure>
  </section>
</Base>

<style>
  .single {
    padding-top: 0.5rem;
  }

  /* Shrink the figure to the photo so the older/newer links hug the photo's
     edges instead of floating out at the window's edges. */
  .figure {
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
  }

  .figure :global(img) {
    max-width: min(100%, 1600px);
    max-height: 80vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    display: block;
  }

  .figure figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9375rem;
  }

  .title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
  }

  .when {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  /* Older month at the left, newer at the right, caption between — the
     links sit on the same line as the caption so they read as part of it. */
  .capbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
  }

  .cap {
    min-width: 0;
  }

  .step {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    line-height: 1.55;
    color: var(--text-faint);
  }

  .step-older {
    text-align: left;
  }

  .step-newer {
    text-align: right;
  }

  .step a {
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .step a:hover,
  .step a:focus-visible {
    color: var(--text);
    border-bottom-color: var(--accent-color, var(--text));
  }

  @media (max-width: 600px) {
    .capbar {
      grid-template-columns: 1fr 1fr;
    }

    .cap {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .step {
      grid-row: 2;
    }
  }

  .note {
    margin: 1.5rem auto 0;
    padding-top: 1.25rem;
    max-width: 34rem;
    text-align: left;
    color: var(--text);
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    border-top: 0.5px solid var(--rule);
  }

  .note :global(p) {
    margin: 0 0 1rem;
  }

  .note :global(p:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  // ← older month, → newer month. Reuses the visible links so ClientRouter
  // handles the transition; guarded so astro:page-load firing on the first
  // load as well doesn't bind twice.
  function initMonthStep() {
    const cap = document.querySelector<HTMLElement>('.capbar');
    if (!cap || cap.dataset.bound === '1') return;
    cap.dataset.bound = '1';

    const controller = new AbortController();
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
        const step = e.key === 'ArrowLeft' ? 'older' : e.key === 'ArrowRight' ? 'newer' : null;
        if (!step) return;
        const link = cap.querySelector<HTMLAnchorElement>(`a[data-step="${step}"]`);
        if (link) {
          e.preventDefault();
          link.click();
        }
      },
      { signal: controller.signal },
    );
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
  }

  initMonthStep();
  document.addEventListener('astro:page-load', initMonthStep);
</script>
