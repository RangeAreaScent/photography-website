---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ogImageUrl } from '../lib/og';

const monthly = (await getCollection('monthly')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = monthly[0];
const fmt = latest?.data.date.toLocaleString('en-US', { year: 'numeric', month: 'long' });
const ogImage = latest ? await ogImageUrl(latest.data.photo, Astro.site) : undefined;
const { Content } = latest ? await render(latest) : { Content: null };
const hasNote = latest ? (latest.body ?? '').trim().length > 0 : false;
---

<Base
  title="Doohee Lee — Photographs"
  description={latest?.data.caption
    ? `${fmt} — ${latest.data.caption}. Photographs by Doohee Lee.`
    : 'Selected photographs and a monthly photograph by Doohee Lee.'}
  ogImage={ogImage}
>
  <section class="home">
    {
      latest && (
        <figure class="hero">
          <Picture
            src={latest.data.photo}
            alt={latest.data.caption ?? fmt ?? 'Latest photograph'}
            formats={['avif', 'webp']}
            widths={[800, 1280, 1920, 2560]}
            sizes="(min-width: 1024px) 70vw, 100vw"
            quality={82}
          />
          <figcaption>
            {latest.data.caption && <p class="title">{latest.data.caption}</p>}
            <p class="when">{fmt}</p>
            {hasNote && Content && (
              <div class="note">
                <Content />
              </div>
            )}
          </figcaption>
        </figure>
      )
    }
  </section>
</Base>

<style>
  .home {
    padding-top: 0.5rem;
  }

  .hero {
    margin: 0;
    text-align: center;
  }

  .hero :global(img) {
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    display: block;
  }

  .hero figcaption {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9375rem;
  }

  .title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
  }

  .when {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .note {
    margin: 1.5rem auto 0;
    padding-top: 1.25rem;
    max-width: 34rem;
    text-align: left;
    color: var(--text);
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    border-top: 0.5px solid var(--rule);
  }

  .note :global(p) {
    margin: 0 0 1rem;
  }

  .note :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
