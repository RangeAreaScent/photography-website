---
import { getCollection } from 'astro:content';
import { monthColor } from '../lib/monthColors';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const inWorks = pathname.startsWith('/works');
const inMonthly = pathname.startsWith('/monthly');

const allWorks = inWorks
  ? (await getCollection('works')).sort((a, b) => a.data.order - b.data.order)
  : [];

const allMonthlySorted = inMonthly
  ? (await getCollection('monthly')).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime(),
    )
  : [];
const allMonthly = allMonthlySorted;

const worksSlug = pathname.replace(/^\/works\/?/, '').replace(/\/$/, '');
const currentWorkId = inWorks
  ? worksSlug === '' ? (allWorks[0]?.id ?? '') : worksSlug
  : '';

const monthlySlug = pathname.replace(/^\/monthly\/?/, '').replace(/\/$/, '');
const currentMonthlyId = inMonthly
  ? monthlySlug === '' ? (allMonthlySorted[0]?.id ?? '') : monthlySlug
  : '';

// One accent color for the whole site, rotating through the 7-color palette
// by day of week. Applied identically everywhere a color shows up: the brand
// box border, and the active nav-link / sub-link underline. Recomputed on
// each build, so it changes when the site is republished on a different day.
const todayColor = monthColor(new Date().getDay());

const fmtMonth = (d: Date) =>
  d.toLocaleString('en-US', { year: 'numeric', month: 'long' });
---

<aside class="site-nav" style={`--accent-color: ${todayColor}`}>
  <a href="/" class="brand" aria-label="Home">Doohee Lee</a>
  <nav aria-label="Primary">
    <a href="/works" class:list={['nav-link', { active: isActive('/works') }]}>Works</a>
    <a href="/monthly" class:list={['nav-link', { active: isActive('/monthly') }]}>Monthly</a>
    <a href="/about" class:list={['nav-link', { active: isActive('/about') }]}>About</a>
    <a href="/drift" class:list={['nav-link', { active: isActive('/drift') }]}>Drift</a>
  </nav>
  <div class="player" transition:persist="bg-player">
    <audio id="bg-audio" src="/audio/sakartvelo.mp3" preload="none" loop></audio>
    <button id="bg-toggle" class="play-btn off" type="button" aria-label="Play music">
      <span class="play-icon" aria-hidden="true">♪</span>
    </button>
  </div>

  {inWorks && (
    <p class="hint">← → to step through photos</p>
  )}

  <p class="meta">© {new Date().getFullYear()}  Doohee Lee</p>
</aside>

{inWorks && allWorks.length > 0 && (
  <aside class="sub-nav" aria-label="Series" style={`--accent-color: ${todayColor}`}>
    <ul>
      {allWorks.map((s) => (
        <li>
          <a
            href={`/works/${s.id}`}
            class:list={['sub-link', { active: currentWorkId === s.id }]}
          >
            {s.data.title}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

{inMonthly && allMonthly.length > 0 && (
  <aside class="sub-nav sub-nav--monthly" aria-label="Monthly" style={`--accent-color: ${todayColor}`}>
    <ul>
      {allMonthly.map((m) => (
        <li>
          <a
            href={`/monthly/${m.id}`}
            class:list={['sub-link', { active: currentMonthlyId === m.id }]}
          >
            {fmtMonth(m.data.date)}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--nav-w);
    height: 100vh;
    padding: 2.5rem 1.25rem 2.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    z-index: 10;
  }

  .brand {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--text);
    line-height: 1.15;
    margin-bottom: 2rem;
    padding: 0.375rem 0.75rem;
    border: 1.5px solid var(--accent-color, var(--rule));
    letter-spacing: 0.005em;
    white-space: nowrap;
    transition: border-color 200ms ease;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 1rem;
    letter-spacing: 0.01em;
    line-height: 1.55;
  }

  .nav-link {
    color: var(--text);
    width: max-content;
    padding-bottom: 0;
    border-bottom: 1px solid transparent;
    transition: border-color 120ms ease;
  }

  .nav-link.active {
    border-bottom-color: var(--accent-color, var(--text));
  }

  .player {
    margin-top: auto;
    padding-top: 1rem;
  }

  .play-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    color: var(--text-muted);
    transition: color 120ms ease;
  }

  .play-btn:hover {
    color: var(--text);
  }

  .play-icon {
    position: relative;
    display: inline-block;
    font-size: 1rem;
    font-style: normal;
    line-height: 1;
  }

  .play-btn.off .play-icon::after {
    content: '';
    position: absolute;
    left: -2px;
    right: -2px;
    top: 50%;
    height: 1px;
    background: currentColor;
    transform: rotate(-40deg);
    transform-origin: center;
    pointer-events: none;
  }

  .hint {
    margin-top: 0.75rem;
    margin-bottom: 0;
    font-size: 0.75rem;
    color: var(--text-faint);
    font-style: italic;
    line-height: 1.4;
  }

  .meta {
    margin-top: 0.5rem;
    margin-bottom: 0;
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.02em;
    font-style: normal;
  }

  .sub-nav {
    position: fixed;
    top: 0;
    left: var(--nav-w);
    width: var(--subnav-w);
    height: 100vh;
    padding: 7.02rem 0.75rem 2.5rem 0.5rem;
    background: var(--bg);
    z-index: 9;
  }

  .sub-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .sub-link {
    color: var(--text-muted);
    display: block;
    width: max-content;
    max-width: 100%;
    font-size: 0.8125rem;
    font-style: normal;
    line-height: 1.55;
    padding-bottom: 0;
    border-bottom: 1px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .sub-link:hover {
    color: var(--text);
  }

  .sub-link.active {
    color: var(--text);
    border-bottom-color: var(--accent-color, var(--text));
  }

  @media (max-width: 1400px) {
    .site-nav {
      position: static;
      width: 100%;
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 1rem;
      padding: 1.25rem 1.25rem 0.75rem;
    }

    .brand {
      margin-bottom: 0;
      margin-right: 0.5rem;
      font-size: 1.125rem;
    }

    nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.875rem;
      font-size: 0.9375rem;
    }

    .meta {
      display: none;
    }

    .hint {
      display: none;
    }

    .sub-nav {
      position: static;
      width: 100%;
      height: auto;
      padding: 0 1.25rem 1rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-bottom: 0.5px solid var(--rule);
    }

    .sub-nav ul {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 1rem;
    }

    .sub-link {
      font-size: 0.8125rem;
      white-space: nowrap;
    }

    .player {
      order: 50;
      margin-left: auto;
      margin-top: 0;
      padding-top: 0;
    }
  }
</style>

<script>
  // Bind the music toggle once. The player element uses transition:persist
  // so it survives ClientRouter navigations and keeps playing; the button
  // already has its click handler attached from the first page load.
  function bindMusicToggle() {
    const audio = document.getElementById('bg-audio') as HTMLAudioElement | null;
    const button = document.getElementById('bg-toggle') as HTMLButtonElement | null;
    if (!audio || !button) return;
    if (button.dataset.bound === '1') return;
    button.dataset.bound = '1';

    const sync = () => {
      button.classList.toggle('off', audio.paused);
      button.setAttribute('aria-label', audio.paused ? 'Play music' : 'Pause music');
    };

    button.addEventListener('click', async () => {
      if (audio.paused) {
        try {
          await audio.play();
        } catch {
          // Autoplay policy may block — ignore; user can click again.
        }
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', sync);
    audio.addEventListener('pause', sync);
    sync();
  }

  bindMusicToggle();
  document.addEventListener('astro:page-load', bindMusicToggle);
</script>
