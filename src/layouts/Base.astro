---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Doohee Lee — Photographs',
  description = 'Selected photographs and a monthly photograph by Doohee Lee.',
  ogImage,
  ogType = 'website',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const siteName = 'Doohee Lee — Photographs';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eaeeee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="content">
      <div class="shell">
        <slot />
      </div>
    </main>
  </body>
</html>

<style>
  .content {
    margin-left: calc(var(--nav-w) + var(--subnav-w));
    min-height: 100vh;
    padding: 2.5rem 0 6rem;
  }

  .content .shell {
    max-width: none;
    margin: 0;
    padding: 0 1.5rem 0 1.5rem;
  }

  @media (max-width: 1400px) {
    .content {
      margin-left: 0;
      padding-top: 1rem;
    }

    .content .shell {
      padding: 0 1.25rem;
    }
  }
</style>

<script>
  // Browsers pick a srcset candidate for <img sizes> once and generally
  // won't fetch a larger one just because a later layout resize (e.g. the
  // sidebar/top-nav breakpoint) makes more room — the image stays stuck at
  // its original resolution until the next full navigation. Re-assigning
  // `sizes` to itself nudges browsers to re-run the candidate-selection
  // algorithm, so a resize actually upgrades the image instead of leaving
  // it capped at the size it loaded at.
  // Photos that haven't loaded yet start transparent (.img-pending) and fade
  // in on load. Already-loaded images (cache hits, back/forward) are left
  // alone so nothing flashes.
  //
  // Unloaded images would otherwise collapse to 0x0 (the pages size photos
  // with width/height:auto, which overrides the width/height attributes), so
  // every lazy photo below the fold shoves the layout down as it arrives.
  // While pending we give the box the size it will end up with — the `sizes`
  // slot, limited by max-height at the photo's aspect ratio (CSS max-width
  // already clamps width without breaking the ratio) — then drop the inline
  // size on load and the natural sizing takes over.
  function sizesSlotPx(sizes: string): number {
    for (const part of sizes.split(',')) {
      const m = part.trim().match(/^(?:\((.+)\)\s+)?(\d+(?:\.\d+)?)(vw|px|rem)$/);
      if (!m) continue;
      if (m[1] && !window.matchMedia(`(${m[1]})`).matches) continue;
      const n = Number(m[2]);
      if (m[3] === 'vw') return (window.innerWidth * n) / 100;
      if (m[3] === 'rem') return n * parseFloat(getComputedStyle(document.documentElement).fontSize);
      return n;
    }
    return window.innerWidth;
  }

  function fadeInImages() {
    document.querySelectorAll<HTMLImageElement>('.content img').forEach((img) => {
      if (img.complete || img.dataset.fade === '1') return;
      img.dataset.fade = '1';
      img.classList.add('img-pending');

      const iw = Number(img.getAttribute('width'));
      const ih = Number(img.getAttribute('height'));
      const reserved = iw > 0 && ih > 0;
      if (reserved) {
        const maxH = parseFloat(getComputedStyle(img).maxHeight);
        let width = sizesSlotPx(img.sizes || '');
        if (maxH) width = Math.min(width, (maxH * iw) / ih);
        img.style.aspectRatio = `${iw} / ${ih}`;
        img.style.width = `${Math.round(width)}px`;
      }

      const done = () => {
        img.classList.remove('img-pending');
        if (reserved) {
          img.style.aspectRatio = '';
          img.style.width = '';
        }
      };
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    });
  }

  const w = window as unknown as { __imgSizesNudgeBound?: boolean };
  if (!w.__imgSizesNudgeBound) {
    w.__imgSizesNudgeBound = true;
    fadeInImages();
    document.addEventListener('astro:page-load', fadeInImages);
    let t: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(t);
      t = setTimeout(() => {
        document.querySelectorAll<HTMLImageElement>('img[sizes]').forEach((img) => {
          img.sizes = img.sizes;
        });
      }, 200);
    });
  }
</script>
